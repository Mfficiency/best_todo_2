<?xml version="1.0" encoding="utf-8"?>
<!-- Best Music's adaptive launcher icon (Android 8+): white background,
     the motion-blurred note as foreground (also the splash-screen icon on
     Android 12+), and the same note as the monochrome layer Android 13+
     tints for themed icons. Older launchers use mipmap-*/ic_launcher.png. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
    <background android:drawable="@color/ic_launcher_background" />
    <foreground android:drawable="@mipmap/ic_launcher_foreground" />
    <monochrome android:drawable="@mipmap/ic_launcher_foreground" />
</adaptive-icon>
