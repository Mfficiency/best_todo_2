<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Installs downloaded updates through a PackageInstaller session. The
         user turns on "install unknown apps" for the app once. -->
    <uses-permission android:name="android.permission.REQUEST_INSTALL_PACKAGES" />

    <application>
        <!-- Install session status: opens Android's "Update this app?". -->
        <receiver
            android:name="ch.mfficiency.updates.InstallReceiver"
            android:exported="false" />
    </application>
</manifest>
